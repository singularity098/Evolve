<?xml version="1.0" encoding="utf-8"?>
<!-- The workout notification during a lifting workout: the current exercise's sets, each a
     circle to tap when it's done (see WorkoutService). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/set0"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/set0_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/notif_set_ring" />
            <TextView
                android:id="@+id/set0_reps"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="15sp" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/set1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/set1_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/notif_set_ring" />
